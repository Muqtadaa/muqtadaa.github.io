{%- set isHome = page.url == "/" -%}
{%- set pageTitle = (site.name + " — " + site.tagline) if isHome else (title + " · " + site.name) -%}
{%- set pageDescription = description or site.description -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
{%- set shareImage = (ogImage or site.portraitUrl) | absoluteUrl(site.url) -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.name }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonical }}">
  {%- endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta property="og:image:alt" content="{{ ogImageAlt or site.portraitAlt }}">
  <meta name="twitter:card" content="summary">
  <link rel="me" href="{{ site.links.linkedin }}">
  <link rel="me" href="{{ site.links.cro }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <link rel="preload" href="/assets/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/utilities.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <script>document.documentElement.classList.add('js');</script>
  <script type="application/ld+json">{{ { site: site, url: page.url, title: title, description: pageDescription, breadcrumbs: breadcrumbs, extra: jsonld, pageType: pageType } | structuredData | safe }}</script>
</head>
