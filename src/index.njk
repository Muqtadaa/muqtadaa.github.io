---
layout: layouts/base.njk
title: Muqtadaa Miandara
description: Digital artist, designer and dungeon master. Drawings, logos, a homebrew D&D world, and a summary of my CRO work at CRO Together.
---
{% import "macros/section-header.njk" as headers %}
{% import "macros/stat.njk" as stats %}

{#- Hero -#}
<section class="section" data-bg="linen" data-py="hero">
  <div class="container split">
    <div class="hero__copy">
      <p class="eyebrow-wide c-sage">Digital artist · Designer · Dungeon master · CRO consultant</p>
      <h1 class="h1 hero__title">I make things for people. Lately: drawings, logos, and a <em>homebrew world.</em></h1>
      <p class="body-lg hero__lead">Hi, I'm Muqtadaa. This is the personal side of my work. If you're here for the growth and experimentation work, that lives at <a href="{{ site.links.cro }}">CRO Together</a>.</p>
      <div class="cluster-3">
        <a class="btn btn--primary" href="/art/">See the art</a>
        <a class="btn btn--outline" href="{{ site.links.croContact }}">Work with me</a>
      </div>
    </div>
    <div class="hero__portrait">
      {% image site.portrait, site.portraitAlt, { widths: [320, 640, 800], sizes: "(min-width: 64em) 24rem, (min-width: 40em) 22rem, 80vw", loading: "eager", decoding: "sync", fetchpriority: "high" } %}
    </div>
  </div>
</section>

{#-
  Gallery teasers. `galleries.art` / `galleries.design` come from
  src/_data/galleries.js in display order (files without an `order` in
  captions.yml, i.e. new uploads, come first). Each item carries `slug`,
  `title`, `alt`, `thumb`, `srcset`, `webpSrcset`, `width` and `height`.
-#}
{%- set teaserSizes = "(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw" %}
{%- set artItems = galleries.art | limit(6) %}
{#- An empty gallery renders no section at all, rather than a note apologising
    for it. check-gallery.mjs warns the author at build time instead. -#}
{%- if artItems.length %}
<section class="section" data-bg="bone" data-py="lg">
  <div class="container stack-8">
    <div class="row-between">
      {{ headers.sectionHeader(title="From the sketchbook") }}
      <a class="link-arrow nav-link" href="/art/">All drawings <span class="arrow-char" aria-hidden="true">→</span></a>
    </div>
    <ul class="grid grid-3" role="list">
      {%- for item in artItems %}
      <li>
        <a class="tile" href="/art/#{{ item.slug }}">
          <div class="tile__media"><picture><source type="image/webp" srcset="{{ item.webpSrcset }}" sizes="{{ teaserSizes }}"><img src="{{ item.thumb }}" srcset="{{ item.srcset }}" sizes="{{ teaserSizes }}" width="{{ item.width }}" height="{{ item.height }}" alt="{{ item.alt }}" loading="lazy" decoding="async"></picture></div>
          <p class="tile__title">{{ item.title }}</p>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- set designItems = galleries.design | limit(6) %}
{%- if designItems.length %}
<section class="section" data-bg="bone" data-py="lg" data-border="top">
  <div class="container stack-8">
    <div class="row-between">
      {{ headers.sectionHeader(title="Design for people I care about") }}
      <a class="link-arrow nav-link" href="/design/">All design work <span class="arrow-char" aria-hidden="true">→</span></a>
    </div>
    <ul class="grid grid-3" role="list">
      {%- for item in designItems %}
      <li>
        <a class="tile" href="/design/#{{ item.slug }}">
          <div class="tile__media"><picture><source type="image/webp" srcset="{{ item.webpSrcset }}" sizes="{{ teaserSizes }}"><img src="{{ item.thumb }}" srcset="{{ item.srcset }}" sizes="{{ teaserSizes }}" width="{{ item.width }}" height="{{ item.height }}" alt="{{ item.alt }}" loading="lazy" decoding="async"></picture></div>
          <p class="tile__title">{{ item.title }}</p>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{#- The table: the three newest D&D posts (collections.dndPost, from src/dnd/posts/) and the map tile. -#}
<section class="section" data-bg="linen" data-py="lg">
  <div class="container stack-8">
    <div class="row-between">
      {{ headers.sectionHeader(title="The table") }}
      <a class="link-arrow nav-link" href="/dnd/">Enter the canon <span class="arrow-char" aria-hidden="true">→</span></a>
    </div>
    {%- set posts = (collections.dndPost | reverse | limit(3)) if collections.dndPost else [] %}
    <div class="{{ 'split split--even split--start' if posts.length else 'stack-4' }}">
      <a class="tile" href="/dnd/">
        <div class="tile__media">
          {% image "gallery/art/agdaron.png", "Hand-drawn map of Agdaron, the homebrew world of the Undying of the Light campaign", { widths: [480, 960], sizes: "(min-width: 64em) 40rem, 100vw" } %}
        </div>
        <p class="tile__title">Agdaron, the world map</p>
        <p class="tile__meta">Drawn for the table, and redrawn every time the party breaks something.</p>
      </a>
      {%- if posts.length %}
      <div class="stack-4">
        <ul class="post-list" role="list">
          {%- for post in posts %}
          <li class="post-list__item">
            <p class="post-list__eyebrow eyebrow-wide">{{ post.data.type | dndTypeLabel }}{% if post.date %} · <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% endif %}</p>
            <p class="post-list__title"><a href="{{ post.url }}">{{ post.data.title }}</a></p>
            {%- if post.data.summary %}<p class="post-list__summary">{{ post.data.summary }}</p>{% endif %}
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}
    </div>
  </div>
</section>

{#- The day job: the one stat PRODUCT.md allows, and a link on to /work/,
    which owns the account of the consultancy and the links out to it. -#}
<section class="section" data-bg="ink" data-py="xl">
  <div class="container stack-8">
    <div class="row-between">
      {{ headers.sectionHeader(title="By day, I run experiments.", variant="dark", size="xl") }}
      <a class="link-arrow nav-link" href="/work/">The work, and how it runs <span class="arrow-char" aria-hidden="true">→</span></a>
    </div>
    <div class="split">
      <p class="body-lg">It's the same instinct as the drawings, really: look closely, notice what people do rather than what they say, and make the thing better.</p>
      {{ stats.stat(value="$15.1M", label="Incremental revenue from experimentation in 2025", variant="dark", size="xl") }}
    </div>
  </div>
</section>

{#- Earlier work: three UX case studies (P2c restyles the pages). -#}
<section class="section" data-bg="bone" data-py="lg">
  <div class="container stack-8">
    <div class="row-between">
      {{ headers.sectionHeader(title="Three UX case studies") }}
      <a class="link-arrow nav-link" href="/work/">All case studies <span class="arrow-char" aria-hidden="true">→</span></a>
    </div>
    <div class="grid grid-3">
      <a class="card" href="/work/yolk/">
        <p class="card__eyebrow eyebrow-wide">2019 · Mobile app</p>
        <p class="card__title">Yolk</p>
        <p class="card__body">A mood-tracking app concept built on Plutchik's wheel of emotions. My UT Dallas capstone.</p>
      </a>
      <a class="card" href="/work/via/">
        <p class="card__eyebrow eyebrow-wide">2020 · Civic tech</p>
        <p class="card__title">Via</p>
        <p class="card__body">If the security problem were solved, what would voting from your phone have to feel like?</p>
      </a>
      <a class="card" href="/work/port-of-peri-peri/">
        <p class="card__eyebrow eyebrow-wide">2019 · Restaurant ordering app</p>
        <p class="card__title">Port of Peri Peri</p>
        <p class="card__body">Fixing a restaurant's ordering funnel from behind the counter, where I could watch every order get stuck.</p>
      </a>
    </div>
  </div>
</section>

{#- What I work with: text chips only, no logo images. -#}
