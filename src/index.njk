  <div class="container stack-8">
    {{ headers.sectionHeader(title="What I work with", size="md") }}
    <div class="grid grid-2">
      <div class="chip-group">
        <p class="chip-group__label label">Experimentation</p>
        <ul class="chips" role="list">
          <li class="chip">Optimizely</li>
          <li class="chip">VWO</li>
          <li class="chip">RICE</li>
          <li class="chip">MDE / power planning</li>
        </ul>
      </div>
      <div class="chip-group">
        <p class="chip-group__label label">Research</p>
        <ul class="chips" role="list">
          <li class="chip">UserTesting</li>
          <li class="chip">Medallia</li>
          <li class="chip">Maze</li>
        </ul>
      </div>
      <div class="chip-group">
        <p class="chip-group__label label">Analytics and build</p>
        <ul class="chips" role="list">
          <li class="chip">GA4</li>
          <li class="chip">GTM</li>
          <li class="chip">Looker Studio</li>
          <li class="chip">HTML / CSS / JS</li>
          <li class="chip">React</li>
        </ul>
      </div>
      <div class="chip-group">
        <p class="chip-group__label label">Design and art</p>
        <ul class="chips" role="list">
          <li class="chip">Figma</li>
          <li class="chip">Photoshop</li>
          <li class="chip">Illustrator</li>
          <li class="chip">After Effects</li>
          <li class="chip">Procreate</li>
        </ul>
      </div>
    </div>
  </div>
</section>
