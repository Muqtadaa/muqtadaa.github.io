  <div class="container stack-8">
    <div class="row-between">
      {{ headers.sectionHeader(eyebrow="UX case studies", title="Earlier work: three UX case studies", description="From before the CRO years: a capstone app, a civic-tech concept, and a restaurant ordering flow I designed while managing the counter.") }}
      <a class="link-arrow nav-link" href="/work/">All case studies <span class="arrow-char" aria-hidden="true">→</span></a>
    </div>
    <div class="grid grid-3">
      <a class="card" href="/work/yolk/">
